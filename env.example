# ---------------------------------------------------------------------------
# ir-watch configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# Local development (file on disk):
DATABASE_URL=sqlite:///ir_watch.db
# Production / GitHub Actions (the runner is disposable - a SQLite file there
# would be lost between runs and the monitor would re-alert everything):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/irwatch

# SMTP -----------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=alerts@example.com
# Comma separated list of recipients:
EMAIL_TO=you@example.com,someone.else@example.com
EMAIL_SUBJECT_PREFIX=[IR Watch]

# Behaviour ------------------------------------------------------------------
TIMEZONE=America/Sao_Paulo
# Alert again when an already-known period is republished with a new document.
# Keep false unless you deliberately want revision alerts.
ALERT_ON_REVISION=false
# Playwright is a FALLBACK. Set to false in environments without a browser.
PLAYWRIGHT_ENABLED=true

# HTTP -----------------------------------------------------------------------
HTTP_TIMEOUT=30
HTTP_RETRIES=3
USER_AGENT=ir-watch/1.0 (peer disclosure monitor; contact: you@example.com)

# Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
