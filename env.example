# ---------------------------------------------------------------------------
# Configuração do IR Watch para rodar no SEU computador (opcional).
#
# No GitHub, o robô NÃO usa este arquivo: as configurações ficam em
# .github/workflows/monitor-simple.yml. Este arquivo só serve para quem
# quiser rodar o robô localmente. Copie para .env e ajuste. Nunca envie o
# .env para o GitHub.
# ---------------------------------------------------------------------------

# Onde o estado (o que já foi visto/alertado) é guardado.
DATABASE_URL=sqlite:///state/ir_watch.db

# Para onde vão os alertas:
#   console      -> só mostra na tela (bom para testar)
#   github_issue -> abre issues no repositório (é o que roda no GitHub;
#                   exige GITHUB_TOKEN e GITHUB_REPOSITORY)
ALERT_PROVIDER=console

# Fuso horário usado nas datas dos alertas.
TIMEZONE=America/Sao_Paulo

# Proteções
# Quantas execuções seguidas com falha até abrir o aviso "sem monitoramento".
BLIND_AFTER_FAILURES=3
# Segundos de espera antes de tentar de novo uma empresa que falhou.
RETRY_DELAY_SECONDS=15

# Alertar de novo quando um período já alertado for republicado.
ALERT_ON_REVISION=false

# Rede
HTTP_TIMEOUT=30
HTTP_RETRIES=3
USER_AGENT=ir-watch/2.0 (peer disclosure monitor)

# Registro
LOG_LEVEL=INFO
